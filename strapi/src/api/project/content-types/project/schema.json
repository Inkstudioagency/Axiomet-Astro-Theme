{
  "kind": "collectionType",
  "collectionName": "projects",
  "info": {
    "singularName": "project",
    "pluralName": "projects",
    "displayName": "Project",
    "description": "Case studies: /project/[slug], /case-study-v1..v3 and the home page work sections"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "required": true,
      "targetField": "name"
    },
    "order": {
      "type": "integer",
      "required": true,
      "min": 0,
      "default": 0
    },
    "category": {
      "type": "string",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "clientLogo": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "statValue": {
      "type": "string",
      "required": true
    },
    "statLabel": {
      "type": "string",
      "required": true
    },
    "summary": {
      "type": "text",
      "required": true
    },
    "shortDescription": {
      "type": "text",
      "required": true
    },
    "clientName": {
      "type": "string",
      "required": true
    },
    "industry": {
      "type": "string",
      "required": true
    },
    "location": {
      "type": "string",
      "required": true
    },
    "engagement": {
      "type": "string",
      "required": true
    },
    "timeline": {
      "type": "string",
      "required": true
    },
    "team": {
      "type": "string",
      "required": true
    },
    "overview": {
      "type": "text",
      "required": true
    },
    "details": {
      "type": "blocks"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
