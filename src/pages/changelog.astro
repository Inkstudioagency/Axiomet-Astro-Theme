---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Changelog from '@/components/sections/changelog/Changelog.astro';
import Cta from '@/components/shared/Cta.astro';
import Footer from '@/components/layout/Footer.astro';

---

<BaseLayout
  title="Changelog - Axiomet"
  description="Release notes for the Axiomet Astro theme, with every update, fix and new section listed by version so you know exactly what changed and when."
>
  <Header />
  <div class="main">
    <Changelog />
    <Cta />
  </div>
  <Footer />
</BaseLayout>
