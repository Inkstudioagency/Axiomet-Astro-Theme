---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Hero from '@/components/sections/contact-v2/Hero.astro';
import ContactForm from '@/components/sections/contact-v2/ContactForm.astro';
import NextSteps from '@/components/sections/contact-v2/NextSteps.astro';
import Faq from '@/components/sections/contact-v2/Faq.astro';
import Footer from '@/components/layout/Footer.astro';

const WF_PAGE = '6b03d34536a37df892a331e0';
---

<BaseLayout
  wfPage={WF_PAGE}
  title="Contact V2 - Axiomet"
  description="The second contact layout in the Axiomet Astro theme, pairing a full-width hero image with an enquiry form card, next steps and common questions."
>
  <div class="hero-area v2">
    <Header />
    <Hero />
  </div>
  <div class="main">
    <ContactForm />
    <NextSteps />
    <Faq />
    <Footer />
  </div>
</BaseLayout>
