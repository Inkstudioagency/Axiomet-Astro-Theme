---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Hero from '@/components/sections/contact-v3/Hero.astro';
import ContactForm from '@/components/sections/contact-v3/ContactForm.astro';
import NextSteps from '@/components/sections/contact-v3/NextSteps.astro';
import Faq from '@/components/sections/contact-v3/Faq.astro';
import Footer from '@/components/layout/Footer.astro';

const WF_PAGE = '6b03d34536a37df892a331e1';
---

<BaseLayout
  wfPage={WF_PAGE}
  title="Contact V3 - Axiomet"
  description="The third contact layout in the Axiomet Astro theme, with a split text hero, a compact enquiry form, four next-step cards and a full FAQ section."
>
  <div class="hero-area v2">
    <Header />
    <Hero />
  </div>
  <div class="main">
    <ContactForm />
    <NextSteps />
    <Faq />
    <Footer />
  </div>
</BaseLayout>
