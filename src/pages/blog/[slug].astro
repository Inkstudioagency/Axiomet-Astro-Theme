---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Hero from '@/components/sections/blog-detail/Hero.astro';
import Body from '@/components/sections/blog-detail/Body.astro';
import Related from '@/components/sections/blog-detail/Related.astro';
import Faq from '@/components/sections/blog-detail/Faq.astro';
import Cta from '@/components/shared/Cta.astro';
import Footer from '@/components/layout/Footer.astro';
import config from '@/config/config.json';
import { getBlogs } from '@/lib/content';

export async function getStaticPaths() {
  const entries = await getBlogs();
  return entries.map((blog) => ({ params: { slug: blog.slug }, props: { blog } }));
}

const { blog } = Astro.props;
const WF_PAGE = '6b03d34536a37df892a331d5';
---

<BaseLayout
  wfPage={WF_PAGE}
  title={blog.seo.metaTitle ?? `${blog.title} - ${config.site.title}`}
  description={blog.seo.metaDescription ?? blog.shortDescription}
  image={blog.image.url}
  type="article"
>
  <div class="hero-area v2">
    <Header />
    <Hero blog={blog} />
  </div>
  <div class="main">
    <Body blog={blog} />
    <Related />
    <Faq />
    <Cta />
    <Footer />
  </div>
</BaseLayout>
