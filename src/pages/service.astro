---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Hero from '@/components/sections/service/Hero.astro';
import Services from '@/components/sections/service/Services.astro';
import HowWeHelp from '@/components/sections/service/HowWeHelp.astro';
import Faq from '@/components/sections/service/Faq.astro';
import Cta from '@/components/shared/Cta.astro';
import Footer from '@/components/layout/Footer.astro';

const WF_PAGE = '6b03d34536a37df892a331d9';
---

<BaseLayout
  wfPage={WF_PAGE}
  title="Service - Axiomet"
  description="Every service in the Axiomet Astro theme, from technology strategy and systems engineering to AI and product innovation, with a detailed FAQ."
>
  <div class="hero-area inner-hero">
    <Header />
    <Hero />
  </div>
  <div class="main">
    <Services />
    <HowWeHelp />
    <Faq />
    <Cta />
    <Footer />
  </div>
</BaseLayout>
