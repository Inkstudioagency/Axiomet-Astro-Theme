---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroMedia from '@/components/sections/blog/HeroMedia.astro';
import Header from '@/components/layout/Header.astro';
import Hero from '@/components/sections/blog/Hero.astro';
import BlogList from '@/components/sections/blog/BlogList.astro';
import Cta from '@/components/shared/Cta.astro';
import Footer from '@/components/layout/Footer.astro';

---

<BaseLayout
  title="Blog - Axiomet"
  description="Insights on technology strategy, engineering and intelligent systems in the Axiomet Astro theme, with a featured article and the latest posts."
>
  <div class="hero-area inner-hero">
    <HeroMedia />
    <Header />
    <Hero />
  </div>
  <div class="main">
    <BlogList />
    <Cta />
    <Footer />
  </div>
</BaseLayout>
