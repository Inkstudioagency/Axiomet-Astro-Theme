---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroMedia from '@/components/sections/case-study-v1/HeroMedia.astro';
import Header from '@/components/layout/Header.astro';
import Hero from '@/components/sections/case-study-v1/Hero.astro';
import Process from '@/components/sections/case-study-v1/Process.astro';
import ProjectList from '@/components/sections/case-study-v1/ProjectList.astro';
import Cta from '@/components/shared/Cta.astro';
import Footer from '@/components/layout/Footer.astro';

---

<BaseLayout
  title="Case Study V1 - Axiomet"
  description="The first case study layout in the Axiomet Astro theme, showing full-width project cards with client logos, results and a clear way of working."
>
  <div class="hero-area inner-hero">
    <HeroMedia />
    <Header />
    <Hero />
  </div>
  <div class="main">
    <Process />
    <ProjectList />
    <Cta />
    <Footer />
  </div>
</BaseLayout>
