---
import { type Project } from '@/lib/content';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<section class="section">
        <div class="section-gap case-v2">
          <div class="w-layout-blockcontainer container w-container">
            <div class="home-hero-content-wrap contact-v3">
              <div class="inner-hero-left blog-detail">
                <div class="project-badge">
                  <div class="pill-dot"></div>
                  <div class="badge-text">{project.category}</div>
                </div>
                <div class="hero-heading-wrap blog-detail">
                  <h1 data-wf-target="[[[&quot;6b03d34536a37df892a331d4&quot;,&quot;1234992f-0fc0-545b-c408-c8fdd3524429&quot;],[]]]" class="">{project.name}</h1>
                  <p class="paragraph-regular contact-v2 blog-detail">{project.shortDescription}</p>
                </div>
              </div>
              <div class="inner-hero-right blog-detail">
                <a data-wf--primary-button--variant="bg-white" data-wf-component-id="4c762986-7cae-1c12-bec9-1ecbb760ee61" data-wf-variant-state="21f200ea-2927-6f93-7fe0-867acd69adf4" href="/contact-v1" class="primary-button w-variant-21f200ea-2927-6f93-7fe0-867acd69adf4 w-inline-block">
                  <div class="button-text-pill">
                    <div class="button-text is-one">Start a Project</div>
                    <div class="button-text is-two">Start a Project</div>
                  </div>
                  <div class="button-arrow-pill"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 20 20" fill="none" class="button-arrow">
                      <path d="M15.8333 12.5002H9.99992H3.33325L3.33325 5.8335V5.3335" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                      <path d="M12.5 16.6668L16.6667 12.5002L12.5 8.3335" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 20 20" fill="none" class="button-arrow">
                      <path d="M15.8333 12.5002H9.99992H3.33325L3.33325 5.8335V5.3335" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                      <path d="M12.5 16.6668L16.6667 12.5002L12.5 8.3335" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg></div>
                </a>
              </div>
            </div>
            <div class="hero-image-wrap case-detail"><img src={project.image.url} loading="lazy" parallax="" alt={project.image.alt} class="home-hero-image case-v2" srcset={project.image.srcset ?? undefined} sizes={project.image.srcset ? '(max-width: 767px) 100vw, (max-width: 991px) 95vw, 939px' : undefined}></div>
          </div>
        </div>
      </section>
