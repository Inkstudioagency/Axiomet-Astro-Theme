---
---

<section class="section">
        <div class="section-gap">
          <div class="w-layout-blockcontainer container w-container">
            <div class="about-wrapper v2">
              <div class="section-header _w-w-work v2">
                <div class="section-badge">
                  <div class="pill-dot"></div>
                  <div class="badge-text">Where we work</div>
                </div>
                <div class="max-width-53">
                  <h2 class="section-heading small">From intelligent software to advanced physical systems, AXIOMET works across industries where technology and engineering create meaningful advantage.</h2>
                </div>
              </div>
              <div class="about-row where-work">
                <div to-top-0="" class="about-image-wrap where-we-work"><img class="about-image v2" src="/images/Rectangle-26.webp" alt="Close-up of a precision robotic device" sizes="(max-width: 767px) 100vw, (max-width: 991px) 95vw, 940px" parallax="" loading="lazy" srcset="/images/Rectangle-26-p-500.webp 500w, /images/Rectangle-26-p-800.webp 800w, /images/Rectangle-26-p-1080.webp 1080w, /images/Rectangle-26-p-1600.webp 1600w, /images/Rectangle-26-p-2000.webp 2000w, /images/Rectangle-26-p-2600.webp 2600w, /images/Rectangle-26.webp 2792w"></div>
                <div class="where-w-work-right">
                  <div class="industry-list">
                    <div class="faq-card">
                      <div to-top-0="" class="faq-right v2">
                        <div class="faq-card-top">
                          <div class="font-normal">AI &amp; Machine Learning</div>
                          <div class="faq-icon-wrap v2"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none" class="faq-icon small">
                              <path d="M11.9922 4V20M19.9922 12H3.99219" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                            </svg></div>
                        </div>
                        <div class="faq-summary-wrap">
                          <p class="faq-summary v2">Creating intelligent systems that transform data into smarter, more informed decisions to drive success.</p>
                        </div>
                      </div>
                    </div>
                    <div class="faq-card">
                      <div to-top-0="" class="faq-right v2">
                        <div class="faq-card-top">
                          <div class="font-normal">Robotics</div>
                          <div class="faq-icon-wrap v2"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none" class="faq-icon small">
                              <path d="M11.9922 4V20M19.9922 12H3.99219" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                            </svg></div>
                        </div>
                        <div class="faq-summary-wrap">
                          <p class="faq-summary v2">Designing connected robotic systems that raise autonomy, precision, and efficiency on real production floors.</p>
                        </div>
                      </div>
                    </div>
                    <div class="faq-card">
                      <div to-top-0="" class="faq-right v2">
                        <div class="faq-card-top">
                          <div class="font-normal">Advanced Manufacturing</div>
                          <div class="faq-icon-wrap v2"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none" class="faq-icon small">
                              <path d="M11.9922 4V20M19.9922 12H3.99219" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                            </svg></div>
                        </div>
                        <div class="faq-summary-wrap">
                          <p class="faq-summary v2">Modernizing production with smart automation and connected machines that cut waste and lift output.</p>
                        </div>
                      </div>
                    </div>
                    <div class="faq-card">
                      <div to-top-0="" class="faq-right v2">
                        <div class="faq-card-top">
                          <div class="font-normal">Healthcare Technology</div>
                          <div class="faq-icon-wrap v2"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none" class="faq-icon small">
                              <path d="M11.9922 4V20M19.9922 12H3.99219" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                            </svg></div>
                        </div>
                        <div class="faq-summary-wrap">
                          <p class="faq-summary v2">Building secure, compliant platforms that streamline clinical operations and improve patient care.</p>
                        </div>
                      </div>
                    </div>
                    <div class="faq-card">
                      <div to-top-0="" class="faq-right v2">
                        <div class="faq-card-top">
                          <div class="font-normal">SaaS &amp; Infrastructure</div>
                          <div class="faq-icon-wrap v2"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none" class="faq-icon small">
                              <path d="M11.9922 4V20M19.9922 12H3.99219" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                            </svg></div>
                        </div>
                        <div class="faq-summary-wrap">
                          <p class="faq-summary v2">Engineering scalable cloud platforms and infrastructure that keep complex products fast and reliable.</p>
                        </div>
                      </div>
                    </div>
                    <div class="faq-card">
                      <div to-top-0="" class="faq-right v2">
                        <div class="faq-card-top">
                          <div class="font-normal">Mechanical Engineering</div>
                          <div class="faq-icon-wrap v2"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none" class="faq-icon small">
                              <path d="M11.9922 4V20M19.9922 12H3.99219" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                            </svg></div>
                        </div>
                        <div class="faq-summary-wrap">
                          <p class="faq-summary v2">Solving hard physical design problems through simulation, rapid prototyping, and precise optimization.</p>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div to-top-0="">
                    <a data-wf--primary-button--variant="bg-white" data-wf-component-id="4c762986-7cae-1c12-bec9-1ecbb760ee61" data-wf-variant-state="21f200ea-2927-6f93-7fe0-867acd69adf4" href="/contact-v1" class="primary-button w-variant-21f200ea-2927-6f93-7fe0-867acd69adf4 w-inline-block">
                      <div class="button-text-pill">
                        <div class="button-text is-one">Start a Conversation</div>
                        <div class="button-text is-two">Start a Conversation</div>
                      </div>
                      <div class="button-arrow-pill"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 20 20" fill="none" class="button-arrow">
                          <path d="M15.8333 12.5002H9.99992H3.33325L3.33325 5.8335V5.3335" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                          <path d="M12.5 16.6668L16.6667 12.5002L12.5 8.3335" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                        </svg><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 20 20" fill="none" class="button-arrow">
                          <path d="M15.8333 12.5002H9.99992H3.33325L3.33325 5.8335V5.3335" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                          <path d="M12.5 16.6668L16.6667 12.5002L12.5 8.3335" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                        </svg></div>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
