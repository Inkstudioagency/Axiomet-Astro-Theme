---
---

<section class="section team">
        <div class="section-gap about-team">
          <div class="w-layout-blockcontainer container w-container">
            <div class="section-header _w-w-work v2">
              <div class="section-badge">
                <div class="pill-dot"></div>
                <div class="badge-text">THE PEOPLE BEHIND AXIOMET</div>
              </div>
              <div class="max-width-28">
                <h2 class="section-heading">Built by people who think in systems.</h2>
              </div>
            </div>
            <div data-delay="4000" data-animation="slide" class="how-w-work-slider about-team w-slider" data-autoplay="false" to-top-0="" data-easing="ease" data-hide-arrows="false" data-disable-swipe="false" data-autoplay-limit="0" data-nav-spacing="3" data-duration="500" data-infinite="true">
              <div class="h-w-work-slider-mask about-team w-slider-mask">
                <div class="h-w-work-slide w-slide">
                  <div class="about-team-card">
                    <div class="about-team-info">
                      <div class="about-team-name">Alex Morgan</div>
                      <div class="font-small">Founder &amp; Technology Strategist</div>
                    </div><img src="/images/Frame-2147227775.webp" loading="lazy" sizes="100vw" srcset="/images/Frame-2147227775-p-500.webp 500w, /images/Frame-2147227775-p-800.webp 800w, /images/Frame-2147227775.webp 1320w" alt="Alex Morgan, Founder &amp; Technology Strategist at Axiomet" class="about-team-image">
                  </div>
                </div>
                <div class="h-w-work-slide w-slide">
                  <div class="about-team-card">
                    <div class="about-team-info">
                      <div class="about-team-name">Maya Chen</div>
                      <div class="font-small">Principal Systems Engineer</div>
                    </div><img src="/images/Frame-2147227778.webp" loading="lazy" sizes="100vw" srcset="/images/Frame-2147227778-p-500.webp 500w, /images/Frame-2147227778-p-800.webp 800w, /images/Frame-2147227778-p-1080.webp 1080w, /images/Frame-2147227778.webp 1320w" alt="Maya Chen, Principal Systems Engineer at Axiomet" class="about-team-image">
                  </div>
                </div>
                <div class="h-w-work-slide w-slide">
                  <div class="about-team-card">
                    <div class="about-team-info">
                      <div class="about-team-name">Ethan Brooks</div>
                      <div class="font-small">AI &amp; Intelligence Lead</div>
                    </div><img src="/images/Frame-2147227779-3.webp" loading="lazy" sizes="100vw" srcset="/images/Frame-2147227779-3-p-500.webp 500w, /images/Frame-2147227779-3-p-800.webp 800w, /images/Frame-2147227779-3-p-1080.webp 1080w, /images/Frame-2147227779-3.webp 1320w" alt="Maya Chen, Principal Systems Engineer at Axiomet" class="about-team-image">
                  </div>
                </div>
                <div class="h-w-work-slide w-slide">
                  <div class="about-team-card">
                    <div class="about-team-info">
                      <div class="about-team-name">Liam Carter</div>
                      <div class="font-small">Chief Technology Architect</div>
                    </div><img src="/images/Frame-2147227775-1.webp" loading="lazy" sizes="100vw" srcset="/images/Frame-2147227775-1-p-500.webp 500w, /images/Frame-2147227775-1-p-800.webp 800w, /images/Frame-2147227775-1-p-1080.webp 1080w, /images/Frame-2147227775-1.webp 1320w" alt="Maya Chen, Principal Systems Engineer at Axiomet" class="about-team-image">
                  </div>
                </div>
                <div class="h-w-work-slide w-slide">
                  <div class="about-team-card">
                    <div class="about-team-info">
                      <div class="about-team-name">Sofiq Patel</div>
                      <div class="font-small">Lead Systems Engineer</div>
                    </div><img src="/images/Frame-2147227778_1.webp" loading="lazy" sizes="100vw" srcset="/images/Frame-2147227778_1-p-500.webp 500w, /images/Frame-2147227778_1-p-800.webp 800w, /images/Frame-2147227778_1.webp 1320w" alt="Maya Chen, Principal Systems Engineer at Axiomet" class="about-team-image">
                  </div>
                </div>
                <div class="h-w-work-slide w-slide">
                  <div class="about-team-card">
                    <div class="about-team-info">
                      <div class="about-team-name">Noah Bennett</div>
                      <div class="font-small">Head of AI and Intelligence</div>
                    </div><img src="/images/Frame-2147227779-2.webp" loading="lazy" sizes="100vw" srcset="/images/Frame-2147227779-2-p-500.webp 500w, /images/Frame-2147227779-2-p-800.webp 800w, /images/Frame-2147227779-2-p-1080.webp 1080w, /images/Frame-2147227779-2.webp 1320w" alt="Maya Chen, Principal Systems Engineer at Axiomet" class="about-team-image">
                  </div>
                </div>
              </div>
              <div class="how-w-card-slider-button left about-team w-slider-arrow-left"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 20 20" fill="none" class="slider-button-arrow">
                  <path d="M3 9L8.6 9L15 9" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                  <path d="M8 4L3 9L8 14" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg></div>
              <div class="how-w-card-slider-button about-team w-slider-arrow-right"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 20 20" fill="none" class="slider-button-arrow">
                  <path d="M16 10L10.4 10L4 10" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                  <path d="M11 15L16 10L11 5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg></div>
              <div class="hide w-slider-nav w-round w-num"></div>
            </div>
          </div>
        </div>
      </section>
