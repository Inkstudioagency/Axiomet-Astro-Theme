                </div>
                <h2 class="section-heading selected-v3">Tackling tough problems with clear, measurable results.</h2>
                <p class="paragraph-regular selected-v3">A look at how we turn difficult technical problems into practical, scalable solutions.</p>
              </div>
              <div to-top-0="" class="project-wrap-block">
                <div class="project-card active">
                  <div class="project-collection-wrapper w-dyn-list">
                    {L3.length > 0 ? (<div role="list" class="project-collection-list w-dyn-items">
                      {L3.map((item) => (<div role="listitem" class="project-collection-item-v1 w-dyn-item">
                        <div class="selected-work-card"><img src={item.image.url} loading="lazy" parallax="" alt={item.image.alt} class="selected-work-image" srcset={item.image.srcset ?? undefined} sizes={item.image.srcset ? '(max-width: 767px) 100vw, (max-width: 991px) 95vw, 939px' : undefined}>
