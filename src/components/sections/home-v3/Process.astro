<section class="section">
        <div class="section-gap process-v3">
          <div class="w-layout-blockcontainer container w-container">
            <div class="about-row top">
              <div to-top-0="" class="how-we-work-image-wrap process-v3"><img class="how-we-work-image process-v3" src="/images/Rectangle-15-11-1.webp" alt="Close-up of a grey robotic device with two dark lens eyes glowing orange" sizes="100vw" parallax="" loading="lazy" srcset="/images/Rectangle-15-11-1-p-500.webp 500w, /images/Rectangle-15-11-1-p-800.webp 800w, /images/Rectangle-15-11-1-p-1080.webp 1080w, /images/Rectangle-15-11-1-p-1600.webp 1600w, /images/Rectangle-15-11-1.webp 2644w"></div>
              <div class="how-we-work-steps process-v3">
                <div to-top-0="" class="section-badge">
                  <div class="pill-dot"></div>
                  <div class="badge-text">Our Process</div>
                </div>
                <div class="how-we-work-steps accordion">
                  <div to-top-0="" class="process-card process-v3 _01">
                    <div class="faq-left-main process-v3">
                      <div class="faq-summary-wrap">
                        <div class="impact-number-wrap process-v3 _01">
                          <div class="process-small-text">01. Discover</div>
                        </div>
                      </div>
                      <div class="how-we-work-title process-v3">Understand the challenge.</div>
                      <div class="faq-summary-wrap process-v3 _01">
                        <p class="faq-summary v2">We thoroughly examine the business context, technical constraints, user needs, system capabilities, and potential opportunities to ensure a comprehensive understanding.</p>
                      </div>
                    </div>
                    <div class="faq-icon-wrap v2"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none" class="faq-icon small _01">
                        <path d="M11.9922 4V20M19.9922 12H3.99219" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                      </svg></div>
                  </div>
                  <div to-top-0="" class="process-card process-v3 _02">
                    <div class="faq-left-main process-v3">
                      <div class="faq-summary-wrap">
                        <div class="impact-number-wrap process-v3 _02">
                          <div class="process-small-text">02. Define</div>
                        </div>
                      </div>
                      <div class="how-we-work-title process-v3">Find the right direction.</div>
                      <div class="faq-summary-wrap process-v3 _02">
                        <p class="faq-summary v2">We simplify complexity by establishing clear priorities, setting precise technical direction, and crafting an actionable strategy that drives success.</p>
                      </div>
                    </div>
                    <div class="faq-icon-wrap v2"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none" class="faq-icon small _02">
                        <path d="M11.9922 4V20M19.9922 12H3.99219" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                      </svg></div>
                  </div>
                  <div to-top-0="" class="process-card process-v3 _03">
                    <div class="faq-left-main process-v3">
                      <div class="faq-summary-wrap">
                        <div class="impact-number-wrap process-v3 _03">
                          <div class="process-small-text">03. Develop</div>
                        </div>
                      </div>
                      <div class="how-we-work-title process-v3">Turn ideas into reality</div>
                      <div class="faq-summary-wrap process-v3 _03">
                        <p class="faq-summary v2">We carefully design, engineer, prototype, and develop innovative solutions that are tailored to meet real-world needs and challenges.</p>
                      </div>
                    </div>
                    <div class="faq-icon-wrap v2"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none" class="faq-icon small _03">
                        <path d="M11.9922 4V20M19.9922 12H3.99219" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                      </svg></div>
                  </div>
                  <div to-top-0="" class="process-card process-v3 _04">
                    <div class="faq-left-main process-v3">
                      <div class="faq-summary-wrap">
                        <div class="impact-number-wrap process-v3 _04">
                          <div class="process-small-text">04. Improve</div>
                        </div>
                      </div>
                      <div class="how-we-work-title process-v3">Make it better.</div>
                      <div class="faq-summary-wrap process-v3 _04">
                        <p class="faq-summary v2">We continuously measure performance, refine our systems, and prepare robust solutions that support sustainable long-term growth and scalability.</p>
                      </div>
                    </div>
                    <div class="faq-icon-wrap v2"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none" class="faq-icon small _04">
                        <path d="M11.9922 4V20M19.9922 12H3.99219" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                      </svg></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
