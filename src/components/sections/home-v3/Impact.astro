<section class="section">
        <div class="section-gap">
          <div class="w-layout-blockcontainer container w-container">
            <div class="impact-header">
              <div class="section-badge">
                <div class="pill-dot"></div>
                <div class="badge-text">The Impact</div>
              </div>
              <div class="max-width-42 impact-v3">
                <h2 class="section-heading small">Turning complex technology challenges into measurable progress, stronger systems, and lasting business impact.</h2>
              </div>
            </div>
            <div class="impact-left v3">
              <div to-top-0="" class="impacy-card v3">
                <div class="impact-number-wrap v3">
                  <div class="pill-dot"></div>
                  <div class="font-extra-small">01.</div>
                </div>
                <div class="impact-card-content">
                  <div data-counter="counter" class="impact-stats">140+</div>
                  <div class="max-width-22">
                    <p class="paragraph-regular">From early strategy to complex engineering, we’ve helped teams move ambitious technology initiatives forward.</p>
                  </div>
                </div>
              </div>
              <div to-top-2="" class="impacy-card v3">
                <div class="impact-number-wrap v3">
                  <div class="pill-dot"></div>
                  <div class="font-extra-small">02.</div>
                </div>
                <div class="impact-card-content">
                  <div data-counter="counter" class="impact-stats">41%</div>
                  <div class="max-width-22">
                    <p class="paragraph-regular">Our solutions help organizations reduce complexity, improve operations, and create measurable gains across critical systems.</p>
                  </div>
                </div>
              </div>
              <div to-top-4="" class="impacy-card v3">
                <div class="impact-number-wrap v3">
                  <div class="pill-dot"></div>
                  <div class="font-extra-small">03.</div>
                </div>
                <div class="impact-card-content">
                  <div data-counter="counter" class="impact-stats">$310M+</div>
                  <div class="max-width-22">
                    <p class="paragraph-regular">Technology decisions become more valuable when strategy, engineering, and business priorities move together.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
