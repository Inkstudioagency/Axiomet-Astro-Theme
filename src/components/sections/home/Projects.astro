          <div class="w-slider-mask">
            <div class="work-slide w-slide">
              <div class="w-dyn-list">
                {L3.length > 0 ? (<div role="list" class="w-dyn-items">
                  {L3.map((item) => (<div role="listitem" class="w-dyn-item">
                    <div class="work-main">
                      <div class="work-left">
                        <div class="section-badge">
                          <div class="pill-dot"></div>
                          <div class="badge-text">Where we work</div>
                        </div>
                        <div class="work-info-wrap">
                          <div class="work-title">{item.name}</div>
                          <p class="paragraph-regular">{item.summary}</p>
                        </div>
                        <a data-wf--primary-button--variant="bg-white" data-wf-component-id="4c762986-7cae-1c12-bec9-1ecbb760ee61" data-wf-variant-state="21f200ea-2927-6f93-7fe0-867acd69adf4" href={`/project/${item.slug}`} class="primary-button w-variant-21f200ea-2927-6f93-7fe0-867acd69adf4 w-inline-block">
