---
import { getBlogs } from '@/lib/content';

const L0 = (await getBlogs('asc')).filter((b) => b.featured).slice(0, 1);
const L1 = (await getBlogs('desc')).filter((b) => !b.featured);
---

<section class="section">
        <div class="section-gap">
          <div class="w-layout-blockcontainer container w-container">
            <div class="w-dyn-list">
              {L0.length > 0 ? (<div role="list" class="w-dyn-items">
                {L0.map((item) => (<div to-top-0="" role="listitem" class="service-card v3 w-dyn-item">
                  <a href={`/blog/${item.slug}`} class="service-card-image-wrap v3 w-inline-block"><img src={item.image.url} loading="lazy" parallax="" alt={item.image.alt} class="service-image" srcset={item.image.srcset ?? undefined} sizes={item.image.srcset ? '(max-width: 767px) 100vw, (max-width: 991px) 95vw, 939px' : undefined}>
                    <div class="demo">#</div>
                  </a>
                  <div class="service-card-info-wrap v3 blog-featured">
                    <div class="blog-card-info-wrap">
                      <div class="badge-text">{item.category}</div>
                      <div class="max-width-32">
                        <div class="font-medium blog-featured">{item.title}</div>
                      </div>
                      <div class="max-width-28">
                        <p class="paragraph-regular blog-featured">{item.shortDescription}</p>
                      </div>
                    </div>
                    <div class="blog-button-wrap">
                      <a href={`/blog/${item.slug}`} class="blog-button v2 w-inline-block">
                        <div class="blog-button-item home-hero">
                          <div class="button-text-pill">
                            <div class="work-button-text is-one">Read Article</div>
                            <div class="work-button-text is-two">Read Article</div>
                          </div>
                          <div class="button-arrow-wrap"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 20 20" fill="none" class="button-arrow">
                              <path d="M15.8335 12.4997H10.0002H3.3335L3.3335 5.83301V5.33301" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                              <path d="M12.5 16.6663L16.6667 12.4997L12.5 8.33301" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                            </svg><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 20 20" fill="none" class="button-arrow">
                              <path d="M15.8335 12.4997H10.0002H3.3335L3.3335 5.83301V5.33301" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                              <path d="M12.5 16.6663L16.6667 12.4997L12.5 8.33301" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                            </svg></div>
                        </div>
                        <div class="button-line"></div>
                      </a>
                    </div>
                  </div>
                </div>))}
              </div>
              ) : (<div class="w-dyn-empty">
                <div>No items found.</div>
              </div>)}
            </div>
            <div class="blog-collection-wrap blog-page">
              <h2 to-top-0="" class="section-heading">Latest Insights</h2>
              <div class="w-dyn-list">
                {L1.length > 0 ? (<div role="list" class="blog-collection-list v2 w-dyn-items">
                  {L1.map((item) => (<div to-top-0="" role="listitem" class="blog-card blog-page w-dyn-item">
                    <a href={`/blog/${item.slug}`} class="blog-image-link v2 w-inline-block"><img src={item.image.url} loading="lazy" parallax="" alt={item.image.alt} class="blog-card-image v2" srcset={item.image.srcset ?? undefined} sizes={item.image.srcset ? '(max-width: 767px) 100vw, (max-width: 991px) 95vw, 939px' : undefined}>
                      <div class="demo">#</div>
                    </a>
                    <div class="blog-card-info-wrap">
                      <div class="badge-text">{item.category}</div>
                      <div class="max-width-28">
                        <div class="font-medium blog-v2">{item.title}</div>
                      </div>
                      <div class="blog-button-wrap v2">
                        <a href={`/blog/${item.slug}`} class="blog-button v2 w-inline-block">
                          <div class="blog-button-item home-hero">
                            <div class="button-text-pill">
                              <div class="work-button-text is-one">Read Article</div>
                              <div class="work-button-text is-two">Read Article</div>
                            </div>
                            <div class="button-arrow-wrap"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 20 20" fill="none" class="button-arrow">
                                <path d="M15.8335 12.4997H10.0002H3.3335L3.3335 5.83301V5.33301" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                                <path d="M12.5 16.6663L16.6667 12.4997L12.5 8.33301" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                              </svg><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 20 20" fill="none" class="button-arrow">
                                <path d="M15.8335 12.4997H10.0002H3.3335L3.3335 5.83301V5.33301" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                                <path d="M12.5 16.6663L16.6667 12.4997L12.5 8.33301" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                              </svg></div>
                          </div>
                          <div class="button-line"></div>
                        </a>
                      </div>
                    </div>
                  </div>))}
                </div>
                ) : (<div class="w-dyn-empty">
                  <div>No items found.</div>
                </div>)}
              </div>
            </div>
          </div>
        </div>
      </section>
