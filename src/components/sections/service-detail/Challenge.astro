---
import { type Service } from '@/lib/content';

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<section class="section">
        <div class="section-gap case-list">
          <div class="w-layout-blockcontainer container w-container">
            <div class="about-row about-who">
              <div class="about-left about-who svc-challenge">
                <div class="about-who-intro">
                  <div class="section-badge">
                    <div class="pill-dot"></div>
                    <div class="badge-text">THE CHALLENGE</div>
                  </div>
                  <h2 class="section-heading svc-challenge">{service.challengeTitle}</h2>
                  <p class="paragraph-regular about-who svc-challenge">{service.challengeDescription}</p>
                </div>
                <div to-top-0="" class="contact-v2-list">
                  <div to-top-0="" class="contact-v2-item">
                    <div class="about-icon-wrap case-v2 svc-challenge"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" width="100%" class="about-card-icon v2">
                        <path d="M2.00017 11.9496C1.96943 12.9853 6.03156 15.4206 6.41417 14.9373C7.15382 13.8962 7.21955 10.1078 6.45955 9.06478C6.10401 8.58035 2.03018 10.9389 2.00017 11.9496Z" stroke="currentColor" stroke-width="1.5"></path>
                        <path d="M11.9496 21.9998C12.9853 22.0305 15.4206 17.9684 14.9373 17.5858C13.8962 16.8462 10.1078 16.7804 9.06478 17.5404C8.58035 17.896 10.9389 21.9698 11.9496 21.9998Z" stroke="currentColor" stroke-width="1.5"></path>
                        <path d="M21.9998 11.9495C22.0306 12.9852 17.9684 15.4206 17.5858 14.9372C16.8462 13.8961 16.7805 10.1078 17.5404 9.06478C17.896 8.58035 21.9698 10.9388 21.9998 11.9495Z" stroke="currentColor" stroke-width="1.5"></path>
                        <path d="M11.9496 2.00017C12.9853 1.96943 15.4206 6.03156 14.9373 6.41416C13.8962 7.15382 10.1078 7.21955 9.06478 6.45955C8.58035 6.10401 10.9389 2.03018 11.9496 2.00017Z" stroke="currentColor" stroke-width="1.5"></path>
                        <path d="M12 14C13.1046 14 14 13.1046 14 12C14 10.8954 13.1046 10 12 10C10.8954 10 10 10.8954 10 12C10 13.1046 10.8954 14 12 14Z" stroke="currentColor" stroke-width="1.5"></path>
                      </svg></div>
                    <div class="about-card-info-wrap contact">
                      <div class="font-extra-normal case-work">{service.challenges[0]?.title}</div>
                      <div class="font-small help">{service.challenges[0]?.description}</div>
                    </div>
                  </div>
                  <div to-top-0="" class="contact-v2-item">
                    <div class="about-icon-wrap case-v2 svc-challenge"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" width="100%" class="about-card-icon v2">
                        <path d="M8.64298 3.14559L6.93816 3.93362C4.31272 5.14719 3 5.75397 3 6.75C3 7.74603 4.31272 8.35281 6.93817 9.56638L8.64298 10.3544C10.2952 11.1181 11.1214 11.5 12 11.5C12.8786 11.5 13.7048 11.1181 15.357 10.3544L17.0618 9.56638C19.6873 8.35281 21 7.74603 21 6.75C21 5.75397 19.6873 5.14719 17.0618 3.93362L15.357 3.14559C13.7048 2.38186 12.8786 2 12 2C11.1214 2 10.2952 2.38186 8.64298 3.14559Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                        <path d="M20.788 11.0972C20.9293 11.2959 21 11.5031 21 11.7309C21 12.7127 19.6873 13.3109 17.0618 14.5072L15.357 15.284C13.7048 16.0368 12.8786 16.4133 12 16.4133C11.1214 16.4133 10.2952 16.0368 8.64298 15.284L6.93817 14.5072C4.31272 13.3109 3 12.7127 3 11.7309C3 11.5031 3.07067 11.2959 3.212 11.0972" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                        <path d="M20.3767 16.2661C20.7922 16.5971 21 16.927 21 17.3176C21 18.2995 19.6873 18.8976 17.0618 20.0939L15.357 20.8707C13.7048 21.6236 12.8786 22 12 22C11.1214 22 10.2952 21.6236 8.64298 20.8707L6.93817 20.0939C4.31272 18.8976 3 18.2995 3 17.3176C3 16.927 3.20778 16.5971 3.62334 16.2661" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                      </svg></div>
                    <div class="about-card-info-wrap contact">
                      <div class="font-extra-normal case-work">{service.challenges[1]?.title}</div>
                      <div class="font-small help">{service.challenges[1]?.description}</div>
                    </div>
                  </div>
                  <div to-top-0="" class="contact-v2-item">
                    <div class="about-icon-wrap case-v2 svc-challenge"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" width="100%" class="about-card-icon v2">
                        <path d="M15.0244 21H12.0222C7.29769 21 4.93543 21 3.46772 19.5355C2 18.0711 2 15.714 2 11V7.94427C2 6.1278 2 5.21956 2.38116 4.53806C2.65287 4.05227 3.0546 3.65142 3.54148 3.38032C4.22449 3 5.13474 3 6.95525 3C8.12158 3 8.70475 3 9.21524 3.19101C10.3808 3.62712 10.8614 4.68358 11.3874 5.73313L12.0222 7M8.01332 7H16.7827C18.8941 7 19.9498 7 20.7081 7.50559C21.0364 7.72447 21.3183 8.00572 21.5377 8.33329C21.8193 8.75388 21.9444 9.26614 22 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                        <path d="M15.9961 14C15.9961 12.6193 17.1159 11.5 18.4973 11.5C19.8786 11.5 20.9984 12.6193 20.9984 14C20.9984 14.8571 20.5668 15.6135 19.9091 16.0639C19.2259 16.5317 18.4985 17.172 18.5 18M18.625 20.75H18.5M18.75 20.75C18.75 20.8881 18.6381 21 18.5 21C18.3619 21 18.25 20.8881 18.25 20.75C18.25 20.6119 18.3619 20.5 18.5 20.5C18.6381 20.5 18.75 20.6119 18.75 20.75Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                      </svg></div>
                    <div class="about-card-info-wrap contact">
                      <div class="font-extra-normal case-work">{service.challenges[2]?.title}</div>
                      <div class="font-small help">{service.challenges[2]?.description}</div>
                    </div>
                  </div>
                  <div to-top-0="" class="contact-v2-item">
                    <div class="about-icon-wrap case-v2 svc-challenge"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" width="100%" class="about-card-icon v2">
                        <path d="M4 15V19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                        <path d="M12 9V19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                        <path d="M22 22H2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                        <path d="M20 13V19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                        <path d="M5.60009 8.79993C5.23521 8.31419 4.6543 8 4 8C2.89543 8 2 8.89543 2 10C2 11.1046 2.89543 12 4 12C5.10457 12 6 11.1046 6 10C6 9.54973 5.8512 9.13421 5.60009 8.79993ZM5.60009 8.79993L10.3999 5.20007M13.7892 4.89462C13.9241 4.62543 14 4.32158 14 4C14 2.89543 13.1046 2 12 2C10.8954 2 10 2.89543 10 4C10 4.45027 10.1488 4.86579 10.3999 5.20007C10.7648 5.68581 11.3457 6 12 6C12.783 6 13.4609 5.55006 13.7892 4.89462ZM13.7892 4.89462L18.2108 7.10538M18.2108 7.10538C18.0759 7.37457 18 7.67842 18 8C18 9.10457 18.8954 10 20 10C21.1046 10 22 9.10457 22 8C22 6.89543 21.1046 6 20 6C19.217 6 18.5391 6.44994 18.2108 7.10538Z" stroke="currentColor" stroke-width="1.5"></path>
                      </svg></div>
                    <div class="about-card-info-wrap contact">
                      <div class="font-extra-normal case-work">{service.challenges[3]?.title}</div>
                      <div class="font-small help">{service.challenges[3]?.description}</div>
                    </div>
                  </div>
                </div>
              </div>
              <div to-top-2="" class="about-image-wrap about-who svc-challenge"><img src={service.challengeImage.url} loading="lazy" parallax="" alt={service.challengeImage.alt} class="about-image v2" srcset={service.challengeImage.srcset ?? undefined} sizes={service.challengeImage.srcset ? '100vw' : undefined}></div>
            </div>
          </div>
        </div>
      </section>
