---
---

<section class="section black-800">
        <div class="section-gap">
          <div class="w-layout-blockcontainer container w-container">
            <div class="about-row approach-v3">
              <div class="contact-v2-info contact-v3">
                <div class="section-header _w-w-work v2">
                  <div class="section-badge">
                    <div class="pill-dot"></div>
                    <div class="badge-text">START A CONVERSATION</div>
                  </div>
                  <h2 class="section-heading">Tell us what you’re working on.</h2>
                  <p to-top-2="" class="font-regular contact-head contact-v2">Give us a look at the challenge you’re facing, and let’s explore what the right solution could look like.</p>
                </div>
                <div class="contact-v2-list">
                  <div to-top-0="" class="contact-v2-item">
                    <div class="about-icon-wrap case-v2"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" width="100%" class="about-card-icon v2">
                        <path d="M7 7.5L9.94202 9.23943C11.6572 10.2535 12.3428 10.2535 14.058 9.23943L17 7.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                        <path d="M21.996 10C21.9933 9.63328 21.9894 9.77017 21.9842 9.5265C21.9189 6.46005 21.8862 4.92682 20.7551 3.79105C19.6239 2.65528 18.0497 2.61571 14.9012 2.53658C12.9607 2.48781 11.0393 2.48781 9.09882 2.53657C5.95033 2.6157 4.37608 2.65526 3.24495 3.79103C2.11382 4.92681 2.08114 6.46003 2.01576 9.52648C1.99474 10.5125 1.99475 11.4926 2.01577 12.4786C2.08114 15.5451 2.11383 17.0783 3.24496 18.2141C4.37608 19.3498 5.95033 19.3894 9.09883 19.4685C9.7068 19.4838 10.4957 19.4943 11 19.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                        <path d="M15.5861 18.6482C14.9573 19.0167 13.3087 19.7693 14.3128 20.711C14.8033 21.171 15.3496 21.5 16.0365 21.5H19.9557C20.6425 21.5 21.1888 21.171 21.6793 20.711C22.6835 19.7693 21.0348 19.0167 20.406 18.6482C18.9315 17.7839 17.0606 17.7839 15.5861 18.6482Z" stroke="currentColor" stroke-width="1.2"></path>
                        <path d="M19.9961 14C19.9961 15.1046 19.1006 16 17.9961 16C16.8915 16 15.9961 15.1046 15.9961 14C15.9961 12.8954 16.8915 12 17.9961 12C19.1006 12 19.9961 12.8954 19.9961 14Z" stroke="currentColor" stroke-width="1.2"></path>
                      </svg></div>
                    <div class="about-card-info-wrap contact">
                      <div class="font-extra-normal case-work">Email</div>
                      <a href="mailto:hello@example.com" class="font-small help">hello@example.com</a>
                    </div>
                  </div>
                  <div to-top-0="" class="contact-v2-item">
                    <div class="about-icon-wrap case-v2"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" width="100%" class="about-card-icon v2">
                        <path d="M10.0808 2C5.47023 2.9359 2 7.01218 2 11.899C2 17.4776 6.52238 22 12.101 22C16.9878 22 21.0641 18.5298 22 13.9192" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"></path>
                        <path d="M18.9375 18C19.3216 17.9166 19.6771 17.784 20 17.603M14.6875 17.3406C15.2831 17.6015 15.8576 17.7948 16.4051 17.9218M10.8546 14.9477C11.2681 15.238 11.71 15.5861 12.1403 15.8865M3 13.825C3.32234 13.6675 3.67031 13.4868 4.0625 13.3321M6.45105 13C7.01293 13.0624 7.64301 13.2226 8.35743 13.5232" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                        <path d="M18.5 7C18.5 6.17157 17.8284 5.5 17 5.5C16.1716 5.5 15.5 6.17157 15.5 7C15.5 7.82843 16.1716 8.5 17 8.5C17.8284 8.5 18.5 7.82843 18.5 7Z" stroke="currentColor" stroke-width="1.2"></path>
                        <path d="M17 2C19.7059 2 22 4.21814 22 6.90917C22 9.64306 19.6685 11.5616 17.515 12.8662C17.3581 12.9539 17.1806 13 17 13C16.8194 13 16.6419 12.9539 16.485 12.8662C14.3355 11.5489 12 9.65251 12 6.90917C12 4.21814 14.2941 2 17 2Z" stroke="currentColor" stroke-width="1.2"></path>
                      </svg></div>
                    <div class="about-card-info-wrap contact">
                      <div class="font-extra-normal case-work">Location</div>
                      <div class="font-small remote">Global / Remote</div>
                    </div>
                  </div>
                  <div to-top-0="" class="contact-v2-item">
                    <div class="about-icon-wrap case-v2"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" width="100%" class="about-card-icon v2">
                        <path d="M18.0104 7.48959L19.5 6M20.5 13.5C20.5 18.1944 16.6944 22 12 22C7.30558 22 3.5 18.1944 3.5 13.5C3.5 8.80558 7.30558 5 12 5C16.6944 5 20.5 8.80558 20.5 13.5Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                        <path d="M12 19C8.96243 19 6.5 16.5376 6.5 13.5C6.5 10.4624 8.96243 8 12 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                        <path d="M14.5 2H9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                        <path d="M12 13.5L15.5 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                      </svg></div>
                    <div class="about-card-info-wrap contact">
                      <div class="font-extra-normal case-work">Availability</div>
                      <div class="font-small remote">Working with teams across technology, engineering, AI, and advanced industries</div>
                    </div>
                  </div>
                </div>
              </div>
              <div to-top-0="" class="contact-form-card contact-v2">
                <div class="contact-form-block w-form">
                  <form id="wf-form-Contact-Form-V3-2" name="wf-form-Contact-Form-V3-2" data-name="Contact Form V3" method="get" class="contact-form" data-wf-page-id="6b03d34536a37df892a331e1" data-wf-element-id="ba8bfe4f-4bcb-03dd-4ac9-ef189c42c0ee">
                    <div class="contact-form-fields">
                      <div class="contact-form-row">
                        <div class="contact-form-field"><label for="" class="contact-form-label">Name</label><input class="contact-form-input w-input" maxlength="256" name="Name" data-name="Name" placeholder="Your name" type="text" id="name" required=""></div>
                        <div class="contact-form-field"><label for="" class="contact-form-label">Name</label><input class="contact-form-input w-input" maxlength="256" name="Name 2" data-name="Name 2" placeholder="Your name" type="text" id="name-2" required=""></div>
                      </div>
                      <div class="contact-form-field"><label for="" class="contact-form-label">Work Email</label><input class="contact-form-input w-input" maxlength="256" name="Work Email" data-name="Work Email" placeholder="you@example.com" type="email" id="work-email" required=""></div>
                      <div class="contact-form-field"><label for="" class="contact-form-label">Company</label><input class="contact-form-input w-input" maxlength="256" name="Company" data-name="Company" placeholder="Company name" type="text" id="company"></div>
                      <div class="contact-form-field"><label for="" class="contact-form-label">Project Type</label>
                        <div class="contact-select-wrap"><select id="project-type" name="Project Type" data-name="Project Type" required="" class="contact-form-input select w-select">
                            <option value="">Select a project type</option>
                            <option value="Technology Strategy">Technology Strategy</option>
                            <option value="Systems &amp; Product Engineering">Systems </option>
                            <option value="AI &amp; Intelligent Systems">AI </option>
                            <option value="Product &amp; Innovation">Product </option>
                            <option value="Other">Other</option>
                          </select><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" width="100%" class="contact-select-icon">
                            <path d="M5.66667 7.99951L9.83333 12.1662L14 7.99951" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                          </svg></div>
                      </div>
                      <div class="contact-form-field"><label for="" class="contact-form-label">Message</label><textarea required="" placeholder="What are you trying to build, solve, or improve?" maxlength="5000" id="message" name="Message" data-name="Message" class="contact-form-input textarea w-input"></textarea></div>
                      <div class="font-small">We’ll review your message and get back to you within 1–2 business days.</div>
                    </div>
                    <div class="contact-submit-wrap"><input type="submit" data-wait="Please wait..." class="submit-button contact-submit w-button" value="Send Project Inquiry"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 20 20" fill="none" class="button-arrow contact-submit">
                        <path d="M15.8333 12.5002H9.99992H3.33325L3.33325 5.8335V5.3335" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                        <path d="M12.5 16.6668L16.6667 12.5002L12.5 8.3335" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                      </svg></div>
                  </form>
                  <div class="contact-form-success w-form-done">
                    <div class="font-regular">Thank you! Your project inquiry has been received. We’ll get back to you within 1–2 business days.</div>
                  </div>
                  <div class="contact-form-error w-form-fail">
                    <div>Oops! Something went wrong while submitting the form. Please try again.</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
